{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Screenwriting knowledge card",
  "type": "object",
  "required": [
    "card_id", "concept_key", "status", "system_id", "work_id", "edition_ids", "evidence",
    "author_claim", "operationalization", "problem_solved", "required_inputs",
    "generation_questions", "diagnostic_criteria", "revision_methods",
    "applicable_when", "prohibited_when", "common_misuses",
    "cross_book_relations", "ai_short_adaptation", "user_notes",
    "external_supplements", "validation_records"
  ],
  "properties": {
    "card_id": {"type": "string", "pattern": "^(STC|EGR|TRU|FLD|MCK)-K[0-9]{4}$"},
    "concept_key": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "reviewed", "approved", "revalidation_required"]},
    "system_id": {"enum": ["STC", "EGR", "TRU", "FLD", "MCK"]},
    "work_id": {"type": "string"},
    "edition_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file_id", "source_sha256", "evidence_status", "locator"],
        "properties": {
          "file_id": {"type": "string"},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "evidence_status": {"enum": ["text_layer", "ocr_verified", "ocr_unverified"]},
          "locator": {"type": "object"}
        }
      }
    },
    "author_claim": {"type": "string", "minLength": 1},
    "operationalization": {"type": "string", "minLength": 1},
    "problem_solved": {"type": "string", "minLength": 1},
    "required_inputs": {"type": "array"},
    "generation_questions": {"type": "array"},
    "diagnostic_criteria": {"type": "array"},
    "revision_methods": {"type": "array"},
    "applicable_when": {"type": "array"},
    "prohibited_when": {"type": "array"},
    "common_misuses": {"type": "array"},
    "cross_book_relations": {"type": "array"},
    "ai_short_adaptation": {
      "type": "object",
      "required": ["label", "text"],
      "properties": {
        "label": {"const": "AI短片适配"},
        "text": {"type": "string"}
      }
    },
    "user_notes": {"type": "array"},
    "external_supplements": {"type": "array"},
    "validation_records": {"type": "array"}
  }
}
